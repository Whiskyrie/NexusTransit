{
    "name": "nexus-transit-monorepo",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "test": "turbo run test",
        "lint": "turbo run lint",
        "dev": "turbo run dev",
        "dev:api": "turbo run dev --filter=@nexus/api",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "clean": "turbo run clean && rm -rf node_modules",
        "clean:build": "rm -rf apps/*/dist packages/*/dist .turbo"
    },
    "devDependencies": {
        "turbo": "^2.0.0",
        "prettier": "^3.0.0",
        "cross-env": "^7.0.0"
    },
    "packageManager": "pnpm@9.0.0"
}