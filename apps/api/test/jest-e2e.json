{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "diagnostics": {
          "ignoreCodes": [
            151002
          ]
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nexus)/)"
  ],
  "moduleNameMapper": {
    "^@nexus/(.*)$": "<rootDir>/../../../packages/$1/src",
    "^@/(.*)$": "<rootDir>/../src/$1"
  },
  "testTimeout": 30000,
  "detectOpenHandles": true,
  "forceExit": true,
  "maxWorkers": 1,
  "workerIdleMemoryLimit": "512MB"
}