{
  "name": "@nexus/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:watch": "nest build --watch --preserveWatchOutput",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand",
    "test:auth": "jest --testPathPatterns=auth",
    "test:auth:cov": "jest --testPathPatterns=auth --coverage",
    "test:auth:e2e": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json --testPathPatterns=auth --runInBand",
    "test:deliveries": "jest --testPathPatterns=deliveries",
    "test:deliveries:cov": "jest --testPathPatterns=deliveries --coverage",
    "test:db:up": "docker-compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker-compose -f docker-compose.test.yml down",
    "test:db:clean": "docker-compose -f docker-compose.test.yml down -v",
    "typeorm": "ts-node --project tsconfig.migration.json -r tsconfig-paths/register ./node_modules/typeorm/cli -d ormconfig.ts",
    "migration:create": "npm run typeorm -- migration:create ./src/database/migrations/Migration",
    "migration:generate": "npm run typeorm -- migration:generate ./src/database/migrations/Migration",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "seed": "ts-node --project tsconfig.migration.json -r tsconfig-paths/register ../../packages/seeding/src/cli/seed.ts",
    "seed:dev": "pnpm seed",
    "seed:test": "pnpm seed -- --env=test",
    "seed:prod": "pnpm seed -- --env=prod",
    "seed:list": "pnpm seed -- --list",
    "seed:roles": "pnpm seed -- roles",
    "seed:admin": "pnpm seed -- admin",
    "seed:users": "pnpm seed -- users",
    "seed:drivers": "pnpm seed -- drivers",
    "seed:vehicles": "pnpm seed -- vehicles",
    "seed:routes": "pnpm seed -- routes",
    "seed:customers": "pnpm seed -- customers",
    "seed:deliveries": "pnpm seed -- deliveries",
    "seed:tracking": "pnpm seed -- tracking",
    "seed:incidents": "pnpm seed -- incidents",
    "docker:dev": "./scripts/dev.sh up",
    "docker:dev:tools": "./scripts/dev.sh up --tools",
    "docker:down": "./scripts/dev.sh down",
    "docker:logs": "./scripts/dev.sh logs",
    "docker:clean": "./scripts/dev.sh clean",
    "docker:build": "./scripts/dev.sh build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.893.0",
    "@aws-sdk/lib-storage": "^3.893.0",
    "@keyv/redis": "^5.1.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.9",
    "@nexus/audit": "workspace:^",
    "@nexus/auth": "workspace:*",
    "@nexus/common": "workspace:*",
    "@nexus/compliance": "workspace:^",
    "@nexus/database": "workspace:^",
    "@nexus/geo-services": "workspace:*",
    "@nexus/logger": "workspace:^",
    "@nexus/rate-limit": "workspace:^",
    "@nexus/redis": "workspace:^",
    "@nexus/reporting": "workspace:^",
    "@nexus/storage": "workspace:^",
    "@types/multer": "^2.0.0",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.7",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "csv-writer": "^1.6.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "geolib": "^3.3.4",
    "keyv": "^5.5.1",
    "multer": "^2.0.2",
    "nestjs-cls": "^6.0.1",
    "nestjs-pino": "^4.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^11.3.0",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.4",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.26",
    "uuid": "10.0.0",
    "xstate": "^5.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.4",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testMatch": [
      "**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@/common/(.*)$": "<rootDir>/common/$1",
      "^@/config/(.*)$": "<rootDir>/config/$1",
      "^@/modules/(.*)$": "<rootDir>/modules/$1",
      "^@/shared/(.*)$": "<rootDir>/shared/$1"
    }
  }
}