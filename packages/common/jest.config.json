{
    "preset": "ts-jest",
    "displayName": "@nexus/common",
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
        "^.+\\.(t|j)s$": [
            "ts-jest",
            {
                "tsconfig": "<rootDir>/../tsconfig.spec.json"
            }
        ]
    },
    "collectCoverageFrom": [
        "**/*.(t|j)s",
        "!**/*.spec.(t|j)s",
        "!**/*.interface.(t|j)s",
        "!**/index.ts",
        "!**/interfaces/**",
        "!**/enums/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
        "global": {
            "branches": 80,
            "functions": 80,
            "lines": 80,
            "statements": 80
        }
    },
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "clearMocks": true,
    "resetMocks": true
}