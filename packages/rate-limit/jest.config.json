{
    "preset": "ts-jest",
    "displayName": "@nexus/rate-limit",
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
        "^.+\\.(t|j)s$": [
            "ts-jest",
            {
                "tsconfig": "<rootDir>/../tsconfig.spec.json"
            }
        ]
    },
    "collectCoverageFrom": [
        "**/*.(t|j)s",
        "!**/*.spec.(t|j)s",
        "!**/*.interface.(t|j)s",
        "!**/index.ts",
        "!**/interfaces/**",
        "!**/enums/**",
        "!**/dto/**",
        "!**/entities/**",
        "!**/config/**",
        "!**/cli/**",
        "!**/rate-limit.controller.ts",
        "!**/processors/**",
        "!**/services/alert.service.ts",
        "!**/services/monitoring.service.ts",
        "!**/decorators/auditable.decorator.ts",
        "!**/decorators/roles.decorator.ts",
        "!**/guards/jwt-auth.guard.ts",
        "!**/guards/roles.guard.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
        "^@nexus/(.*)$": "<rootDir>/../../$1/src"
    },
    "setupFilesAfterEnv": [
        "<rootDir>/test/setup.ts"
    ],
    "testTimeout": 10000,
    "coverageThreshold": {
        "global": {
            "branches": 55,
            "functions": 80,
            "lines": 80,
            "statements": 80
        }
    },
    "clearMocks": true,
    "resetMocks": true
}