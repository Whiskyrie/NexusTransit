{
    "name": "@nexus/rate-limit",
    "version": "1.0.0",
    "description": "Distributed rate limiting and throttling utilities for NexusTransit",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "clean": "rm -rf dist tsconfig.tsbuildinfo",
        "lint": "eslint . --ext .ts",
        "test": "echo \"No tests configured for rate-limit\" && exit 0"
    },
    "keywords": [
        "nexus",
        "rate-limit",
        "throttling",
        "redis",
        "distributed",
        "api-protection"
    ],
    "author": "NexusTransit",
    "license": "UNLICENSED",
    "peerDependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/throttler": "^6.0.0",
        "rxjs": "^7.8.0"
    },
    "dependencies": {
        "@nestjs/testing": "^11.1.9",
        "@nexus/audit": "workspace:^",
        "@nexus/auth": "workspace:^",
        "@nexus/common": "workspace:^",
        "@nexus/redis": "workspace:^",
        "jest": "^30.2.0"
    },
    "devDependencies": {
        "@nestjs/config": "^3.3.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/schedule": "^6.1.0",
        "@nestjs/swagger": "^11.2.3",
        "@nestjs/typeorm": "^11.0.0",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "typeorm": "^0.3.28",
        "typescript": "^5.3.0"
    }
}