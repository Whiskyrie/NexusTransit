{
    "name": "@nexus/compliance",
    "version": "1.0.0",
    "description": "LGPD compliance, data privacy and protection utilities for NexusTransit",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "clean": "rm -rf dist tsconfig.tsbuildinfo",
        "lint": "eslint . --ext .ts"
    },
    "keywords": [
        "nexus",
        "compliance",
        "lgpd",
        "gdpr",
        "privacy",
        "data-protection"
    ],
    "author": "NexusTransit",
    "license": "UNLICENSED",
    "peerDependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/typeorm": "^10.0.0",
        "typeorm": "^0.3.0"
    },
    "dependencies": {
        "@nexus/audit": "workspace:^",
        "@nexus/auth": "workspace:^",
        "@nexus/common": "workspace:^",
        "crypto": "*"
    },
    "devDependencies": {
        "@nestjs/typeorm": "^11.0.0",
        "@types/express": "^5.0.6",
        "@types/node": "^22.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "typeorm": "^0.3.28",
        "typescript": "^5.3.0"
    }
}