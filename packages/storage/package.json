{
    "name": "@nexus/storage",
    "version": "1.0.0",
    "description": "Storage and file upload utilities for NexusTransit - S3 compatible storage (Backblaze B2)",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "clean": "rm -rf dist tsconfig.tsbuildinfo",
        "lint": "eslint . --ext .ts"
    },
    "keywords": [
        "nexus",
        "storage",
        "upload",
        "s3",
        "backblaze",
        "images",
        "thumbnails"
    ],
    "author": "NexusTransit",
    "license": "MIT",
    "peerDependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.893.0",
        "@aws-sdk/lib-storage": "^3.893.0",
        "@nestjs/swagger": "^11.2.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "sharp": "^0.34.4",
        "uuid": "10.0.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.0.0",
        "@types/uuid": "^10.0.0",
        "eslint": "^9.18.0",
        "typescript": "^5.6.0"
    }
}