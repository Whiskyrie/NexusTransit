{
    "name": "@nexus/seeding",
    "version": "1.0.0",
    "description": "Database seeding utilities for NexusTransit",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "clean": "rm -rf dist tsconfig.tsbuildinfo coverage",
        "lint": "echo \"No lint configured for seeding\" && exit 0",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "seed:run": "ts-node src/cli/seed.ts",
        "seed:run:dev": "ts-node src/cli/seed.ts --env=dev",
        "seed:run:test": "ts-node src/cli/seed.ts --env=test",
        "seed:run:prod": "ts-node src/cli/seed.ts --env=prod",
        "seed:roles": "ts-node src/cli/seed.ts roles",
        "seed:admin": "ts-node src/cli/seed.ts admin",
        "seed:users": "ts-node src/cli/seed.ts users",
        "seed:list": "ts-node src/cli/seed.ts --list"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/typeorm": "^11.0.0",
        "bcrypt": "^5.1.1",
        "dotenv": "^16.0.3",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.0",
        "typeorm": "^0.3.20"
    },
    "devDependencies": {
        "@nestjs/core": "^11.1.9",
        "@nestjs/testing": "^11.1.9",
        "@types/bcrypt": "^5.0.2",
        "@types/jest": "^29.5.14",
        "@types/node": "^20.0.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.0",
        "typescript": "^5.0.0"
    },
    "peerDependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/typeorm": "^11.0.0",
        "typeorm": "^0.3.20"
    }
}