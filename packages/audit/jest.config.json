{
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
        "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
        "^@nexus/common$": "<rootDir>/../../common/src",
        "^@nexus/common/(.*)$": "<rootDir>/../../common/src/$1"
    },
    "globals": {
        "ts-jest": {
            "tsconfig": {
                "types": [
                    "jest",
                    "node"
                ]
            }
        }
    }
}