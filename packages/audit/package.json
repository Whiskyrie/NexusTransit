        "@nestjs/typeorm": "^11.0.0",
        "@nexus/common": "workspace:*",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "csv-writer": "^1.6.0",
        "date-fns": "^4.1.0",
        "nestjs-cls": "^5.0.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.1",
        "typeorm": "^0.3.20"
    },
    "devDependencies": {
        "@nestjs/testing": "^11.1.9",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "@types/supertest": "^6.0.3",
