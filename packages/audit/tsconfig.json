{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "composite": true,
        "types": [
            "jest",
            "node"
        ],
        "paths": {
            "@nexus/common": [
                "../common/src"
            ],
            "@nexus/common/*": [
                "../common/src/*"
            ]
        }
    },
    "references": [
        {
            "path": "../common"
        }
    ],
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}