{
    "name": "@nexus/logger",
    "version": "1.0.0",
    "description": "Shared logging module for NexusTransit",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "clean": "rm -rf dist tsconfig.tsbuildinfo",
        "lint": "eslint . --ext .ts"
    },
    "dependencies": {
        "nestjs-pino": "^4.4.1",
        "pino": "^9.14.0",
        "pino-http": "^10.5.0",
        "pino-pretty": "^11.3.0",
        "uuid": "10.0.0"
    },
    "peerDependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@nestjs/common": "^11.0.1",
        "@nestjs/core": "^11.0.1",
        "@nestjs/swagger": "^11.2.0",
        "@types/express": "^5.0.6",
        "@types/node": "^22.0.0",
        "@types/uuid": "^10.0.0",
        "eslint": "^9.18.0",
        "typescript": "^5.3.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    }
}